# __PLACEHOLDERS__ are filled in from environment variables when the
# container starts, so the Gmail app password never ends up in git or the image.
global:
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "SecureFlow Alerts <__GMAIL_USER__>"
  smtp_auth_username: "__GMAIL_USER__"
  smtp_auth_password: "__GMAIL_APP_PASSWORD__"
  smtp_require_tls: true

route:
  receiver: email
  group_by: [alertname, env]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 2h
  routes:
    # every staging deploy runs an attack test on purpose, so staging's
    # security alerts are expected noise - the only staging alert worth an
    # email is the service actually being down
    - matchers: [env="staging", alertname!="SecureFlowDown"]
      receiver: "null"

receivers:
  - name: "null"
  - name: email
    email_configs:
      - to: "__ALERT_EMAIL_TO__"
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} ({{ .CommonLabels.env }})'

inhibit_rules:
  # if the whole service is down, don't also spam about its error rate
  - source_matchers: [alertname="SecureFlowDown"]
    target_matchers: [alertname="HighErrorRate"]
    equal: [env]
