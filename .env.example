# Copy this file to .env and fill it in. Never commit .env - it's in .gitignore.

# Jenkins login
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# GitHub - personal access token (classic) with the "repo" scope
GITHUB_USER=Dhruv12aj
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
REPO_URL=https://github.com/Dhruv12aj/SecureFlow.git

# SonarQube token - generate it at http://localhost:9000 (My Account > Security)
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxx

# API keys for each environment - any long random strings
STAGING_ANALYST_KEY=staging-analyst-change-me
STAGING_ADMIN_KEY=staging-admin-change-me
PROD_ANALYST_KEY=prod-analyst-change-me
PROD_ADMIN_KEY=prod-admin-change-me

# Alert emails - use a Gmail App Password, not your normal password
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
ALERT_EMAIL_TO=you@gmail.com

GRAFANA_ADMIN_PASSWORD=change-me
